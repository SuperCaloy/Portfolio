# ---- Stage 1: build frontend assets (Vite/Inertia/React) ----
FROM node:20-alpine AS assets
WORKDIR /app

# Render auto-forwards dashboard Environment vars as build args,
# but only for ARGs explicitly declared here
ARG VITE_ADMIN_SLUG
ENV VITE_ADMIN_SLUG=$VITE_ADMIN_SLUG
ARG VITE_APP_NAME
ENV VITE_APP_NAME=$VITE_APP_NAME

COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Stage 2: PHP runtime ----
FROM php:8.3-fpm AS app

RUN apt-get update && apt-get install -y \
    git \
    curl \
    nginx \
    supervisor \
    gettext-base \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Install PHP deps first (better layer caching)
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --optimize-autoloader

# Copy app code
COPY . .

# Bring in the built frontend assets from stage 1
COPY --from=assets /app/public/build ./public/build

RUN composer dump-autoload --optimize --no-dev

# Nginx config template, PORT and FASTCGI_PASS get substituted at container start
# since Render assigns PORT dynamically and nginx config files cannot read env vars directly
COPY docker/nginx/default.conf.template /etc/nginx/conf.d/default.conf.template
RUN rm -f /etc/nginx/sites-enabled/default

# Supervisord manages php-fpm and nginx as sibling processes in one container
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod +x docker/start.sh

# Ownership for Laravel writable paths, php-fpm workers run as www-data by default
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

# Render sets PORT at runtime, the app must listen on it
EXPOSE 10000

CMD ["docker/start.sh"]